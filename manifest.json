{
  "manifest_version": 2,
  "name": "Preprint Bridge",
  "version": "1.3.1",
  "description": "Find published versions of arXiv papers, review metadata, and keep your Zotero items and annotations.",
  "homepage_url": "https://github.com/Kazuma-yj/preprint-bridge",
  "author": "Kazuma-yj",
  "applications": {
    "zotero": {
      "id": "preprint-bridge@research.local",
      "update_url": "https://raw.githubusercontent.com/Kazuma-yj/preprint-bridge/main/update.json",
      "strict_min_version": "10.0",
      "strict_max_version": "10.0.*"
    }
  }
}
