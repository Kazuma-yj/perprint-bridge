{
  "manifest_version": 2,
  "name": "Preprint Bridge",
  "version": "0.1.3",
  "description": "Review and apply published metadata to arXiv items without losing their Zotero identity or attachments.",
  "homepage_url": "https://github.com/Kazuma-yj/perprint-bridge",
  "author": "Kazuma-yj",
  "applications": {
    "zotero": {
      "id": "preprint-bridge@research.local",
      "update_url": "https://raw.githubusercontent.com/Kazuma-yj/perprint-bridge/main/update.json",
      "strict_min_version": "10.0",
      "strict_max_version": "10.0.*"
    }
  }
}
